{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "importHelpers": true,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "paths": {
      "@worship/shared-dto": ["./packages/shared/dto/src/index.ts"],
      "@worship/shared-ui": ["./packages/shared/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
