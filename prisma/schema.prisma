generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  LEADER
  OPERATOR
  MEMBER
  VIEWER
}

enum ServiceStatus {
  DRAFT
  PLANNING
  READY
  LIVE
  COMPLETED
}

enum LineupItemType {
  SONG
  BIBLE
  SLIDE
  IMAGE
  VIDEO
  AUDIO
  COUNTDOWN
  CLOCK
  SERMON
  TEXT
  BLANK
}

enum SongSectionType {
  INTRO
  VERSE
  PRE_CHORUS
  CHORUS
  BRIDGE
  TAG
  ENDING
}

enum TeamAssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
  UNAVAILABLE
  REPLACEMENT_REQUESTED
}

enum LiveSessionStatus {
  PREPARING
  READY
  LIVE
  ENDED
}

enum MediaAssetKind {
  IMAGE
  VIDEO
  AUDIO
  MOTION_BACKGROUND
  LOGO
  COUNTDOWN_VIDEO
}

enum CountdownMode {
  DURATION
  TARGET_TIME
}

model Organization {
  id                String                @id @default(cuid())
  name              String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  locations         Location[]
  memberships       Membership[]
  services          Service[]
  songs             Song[]
  events            DomainEvent[]
  notifications     Notification[]
  bibleTranslations BibleTranslation[]
  biblePassages     BiblePassage[]
  mediaAssets       MediaAsset[]
  slideTemplates    SlideTemplate[]
  slides            SlideDocument[]
  countdowns        CountdownDefinition[]
}

model Location {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services       Service[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id                   String                  @id @default(cuid())
  email                String                  @unique
  name                 String
  active               Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  memberships          Membership[]
  responsibleServices  Service[]               @relation("ResponsibleUser")
  credential           AuthCredential?
  sessions             AuthSession[]
  events               DomainEvent[]           @relation("EventActor")
  notifications        Notification[]
  teamAssignments      ServiceTeamAssignment[]
  programOwnedSessions LiveSession[]           @relation("ProgramOwner")
}

model AuthCredential {
  userId       String   @id
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Membership {
  organizationId String
  userId         String
  roles          UserRole[]
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

model Service {
  id                String                  @id @default(cuid())
  organizationId    String
  locationId        String
  responsibleUserId String
  title             String
  date              DateTime                @db.Date
  time              String
  notes             String?
  status            ServiceStatus           @default(DRAFT)
  teamReady         Boolean                 @default(false)
  mediaReady        Boolean                 @default(false)
  presentationReady Boolean                 @default(false)
  outputsReady      Boolean                 @default(false)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location          Location                @relation(fields: [locationId], references: [id])
  responsibleUser   User                    @relation("ResponsibleUser", fields: [responsibleUserId], references: [id])
  lineup            LineupItem[]
  team              ServiceTeamAssignment[]
  liveSessions      LiveSession[]

  @@index([organizationId, date, time])
  @@index([responsibleUserId])
}

model LiveSession {
  id                          String            @id @default(cuid())
  serviceId                   String
  programOwnerId              String?
  programControlRequestUserId String?
  programControlRequestedAt   DateTime?
  outputAccessKey             String            @unique @default(cuid())
  status                      LiveSessionStatus @default(PREPARING)
  preview                     Json?
  program                     Json?
  countdown                   Json?
  operatorMessage             Json?
  blackout                    Boolean           @default(false)
  version                     Int               @default(0)
  startedAt                   DateTime?
  endedAt                     DateTime?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  service                     Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  programOwner                User?             @relation("ProgramOwner", fields: [programOwnerId], references: [id], onDelete: SetNull)

  @@index([programOwnerId])
  @@index([status])
  @@index([serviceId, createdAt])
}

model ServiceTeamAssignment {
  id        String               @id @default(cuid())
  serviceId String
  userId    String
  role      String
  status    TeamAssignmentStatus @default(PENDING)
  note      String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  service   Service              @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serviceId, userId, role])
  @@index([serviceId, status])
  @@index([userId, status])
}

model LineupItem {
  id            String              @id @default(cuid())
  serviceId     String
  type          LineupItemType
  title         String
  position      Int
  sourceId      String?
  contentLocale String?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  service       Service             @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  visualSlides  LineupVisualSlide[]

  @@unique([serviceId, position])
  @@index([serviceId])
}

model LineupVisualSlide {
  id           String                    @id @default(cuid())
  lineupItemId String
  name         String
  position     Int
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  lineupItem   LineupItem                @relation(fields: [lineupItemId], references: [id], onDelete: Cascade)
  layouts      LineupVisualSlideLayout[]

  @@unique([lineupItemId, position])
  @@index([lineupItemId])
}

model LineupVisualSlideLayout {
  id                  String            @id @default(cuid())
  lineupVisualSlideId String
  target              String
  templateId          String?
  layout              Json
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  lineupVisualSlide   LineupVisualSlide @relation(fields: [lineupVisualSlideId], references: [id], onDelete: Cascade)
  template            SlideTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([lineupVisualSlideId, target])
  @@index([templateId])
}

model Song {
  id             String            @id @default(cuid())
  organizationId String
  locale         String            @default("und")
  title          String
  author         String?
  copyright      String?
  ccli           String?
  key            String?
  bpm            Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sections       SongSection[]
  arrangements   SongArrangement[]
  translations   SongTranslation[]
  visualSlides   SongVisualSlide[]

  @@index([organizationId, title])
}

model SongSection {
  id           String            @id @default(cuid())
  songId       String
  type         SongSectionType
  label        String
  content      String
  position     Int
  song         Song              @relation(fields: [songId], references: [id], onDelete: Cascade)
  steps        SongStep[]
  visualSlides SongVisualSlide[]

  @@unique([songId, position])
}

model SongStep {
  id        String      @id @default(cuid())
  sectionId String
  position  Int
  content   String
  lines     String[]
  lineStart Int
  lineEnd   Int
  section   SongSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, position])
  @@index([sectionId])
}

model SongArrangement {
  id         String   @id @default(cuid())
  songId     String
  name       String
  sectionIds String[]
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, name])
}

model SongTranslation {
  id          String                   @id @default(cuid())
  songId      String
  locale      String
  title       String
  generatedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  song        Song                     @relation(fields: [songId], references: [id], onDelete: Cascade)
  sections    SongTranslationSection[]

  @@unique([songId, locale])
  @@index([songId])
}

model SongTranslationSection {
  id            String          @id @default(cuid())
  translationId String
  type          SongSectionType
  label         String
  content       String
  position      Int
  translation   SongTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@unique([translationId, position])
}

model SongVisualSlide {
  id        String                  @id @default(cuid())
  songId    String
  sectionId String
  name      String
  position  Int
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  song      Song                    @relation(fields: [songId], references: [id], onDelete: Cascade)
  section   SongSection             @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  layouts   SongVisualSlideLayout[]

  @@unique([songId, position])
  @@index([songId, sectionId])
}

model SongVisualSlideLayout {
  id                String          @id @default(cuid())
  songVisualSlideId String
  target            String
  templateId        String?
  layout            Json
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  songVisualSlide   SongVisualSlide @relation(fields: [songVisualSlideId], references: [id], onDelete: Cascade)
  template          SlideTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([songVisualSlideId, target])
  @@index([templateId])
}

model BibleTranslation {
  id             String         @id @default(cuid())
  organizationId String
  locale         String         @default("und")
  name           String
  abbreviation   String
  copyright      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  verses         BibleVerse[]
  passages       BiblePassage[]

  @@unique([organizationId, abbreviation])
  @@index([organizationId, name])
}

model BibleVerse {
  id            String           @id @default(cuid())
  translationId String
  book          String
  bookOrder     Int
  chapter       Int
  verse         Int
  text          String
  translation   BibleTranslation @relation(fields: [translationId], references: [id], onDelete: Cascade)

  @@unique([translationId, book, chapter, verse])
  @@index([translationId, bookOrder, chapter, verse])
}

model BiblePassage {
  id             String                    @id @default(cuid())
  organizationId String
  translationId  String
  book           String
  chapter        Int
  verseStart     Int
  verseEnd       Int
  reference      String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  translation    BibleTranslation          @relation(fields: [translationId], references: [id], onDelete: Cascade)
  translations   BiblePassageTranslation[]

  @@index([organizationId, translationId])
}

model BiblePassageTranslation {
  id          String       @id @default(cuid())
  passageId   String
  locale      String
  verses      Json
  generatedAt DateTime     @default(now())
  provider    String
  model       String
  passage     BiblePassage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@unique([passageId, locale])
  @@index([passageId])
}

model MediaAsset {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  kind           MediaAssetKind
  url            String
  thumbnailUrl   String?
  durationMs     Int?
  width          Int?
  height         Int?
  category       String?
  tags           String[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind])
  @@index([organizationId, name])
}

model SlideTemplate {
  id                  String                    @id @default(cuid())
  organizationId      String
  name                String
  kind                String
  target              String                    @default("Main")
  layout              Json
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slides              SlideDocument[]
  songVisualLayouts   SongVisualSlideLayout[]
  lineupVisualLayouts LineupVisualSlideLayout[]

  @@unique([organizationId, name])
  @@index([organizationId, kind])
}

model SlideDocument {
  id             String         @id @default(cuid())
  organizationId String
  templateId     String?
  name           String
  content        Json
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template       SlideTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([organizationId, name])
  @@index([templateId])
}

model CountdownDefinition {
  id              String        @id @default(cuid())
  organizationId  String
  name            String
  mode            CountdownMode
  durationSeconds Int?
  targetAt        DateTime?
  autoAdvance     Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, name])
}

model DomainEvent {
  id             String         @id @default(cuid())
  type           String
  organizationId String?
  actorUserId    String?
  subjectId      String?
  payload        Json
  correlationId  String
  occurredAt     DateTime       @default(now())
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?          @relation("EventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  notifications  Notification[]

  @@index([organizationId, occurredAt])
  @@index([type, occurredAt])
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  eventId        String?
  kind           String
  title          String
  body           String
  data           Json
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event          DomainEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([userId, organizationId, readAt, createdAt])
}
