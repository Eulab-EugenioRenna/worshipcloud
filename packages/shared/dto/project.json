{
  "name": "shared-dto",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/shared/dto/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p packages/shared/dto/tsconfig.lib.json"
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/shared/dto",
        "main": "packages/shared/dto/src/index.ts",
        "tsConfig": "packages/shared/dto/tsconfig.lib.json",
        "assets": []
      }
    }
  }
}
